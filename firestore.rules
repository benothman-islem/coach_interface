rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCoach() {
      return signedIn() && currentUser().role == 'coach';
    }

    function isAdherent() {
      return signedIn() && currentUser().role in ['adherent', 'member'];
    }

    function isMemberOf(coachId) {
      return signedIn()
        && currentUser().role in ['member', 'adherent']
        && currentUser().coachId == coachId;
    }

    function validCoachProfile(uid) {
      return owns(uid)
        && request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'role', 'createdAt',
          'specialties', 'isActive', 'experienceYears'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'photoUrl', 'role', 'createdAt',
          'specialties', 'coachSince', 'rating', 'experienceYears', 'isActive'
        ])
        && request.resource.data.role == 'coach'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && (!request.resource.data.keys().hasAny(['photoUrl'])
          || request.resource.data.photoUrl is string)
        && request.resource.data.specialties is list
        && request.resource.data.experienceYears is int
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt == request.time;
    }

    function validSession() {
      return request.resource.data.keys().hasAll([
          'coachId', 'type', 'title', 'studio', 'startAt', 'durationMin',
          'capacity', 'enrolledIds', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'coachId', 'type', 'title', 'studio', 'startAt', 'durationMin',
          'capacity', 'enrolledIds', 'createdAt'
        ])
        && request.resource.data.coachId == request.auth.uid
        && request.resource.data.type in ['HIIT', 'Cross', 'Mobilité']
        && request.resource.data.title is string
        && request.resource.data.studio is string
        && request.resource.data.startAt is timestamp
        && request.resource.data.durationMin is int
        && request.resource.data.capacity is int
        && request.resource.data.enrolledIds is list
        && request.resource.data.createdAt is timestamp;
    }

    function memberEnrollmentChange() {
      let oldIds = resource.data.enrolledIds;
      let newIds = request.resource.data.enrolledIds;
      return isMemberOf(resource.data.coachId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['enrolledIds'])
        && oldIds is list
        && newIds is list
        && (
          (!oldIds.hasAny([request.auth.uid])
            && newIds.hasAll(oldIds)
            && newIds.hasAny([request.auth.uid])
            && newIds.size() == oldIds.size() + 1)
          ||
          (oldIds.hasAny([request.auth.uid])
            && oldIds.hasAll(newIds)
            && !newIds.hasAny([request.auth.uid])
            && newIds.size() == oldIds.size() - 1)
        );
    }

    match /users/{uid} {
      allow get, list: if owns(uid)
        || (isCoach()
          && resource.data.role == 'member')
        || (isAdherent() && resource.data.role == 'coach');
      allow create: if validCoachProfile(uid);
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if (isCoach() && resource.data.coachId == request.auth.uid)
        || isMemberOf(resource.data.coachId);
      allow create: if isCoach() && validSession();
      allow update: if (isCoach()
          && resource.data.coachId == request.auth.uid
          && validSession()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'type', 'title', 'studio', 'startAt', 'durationMin', 'capacity'
            ]))
        || memberEnrollmentChange();
      allow delete: if isCoach()
        && resource.data.coachId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
